# Скопируйте в .env и заполните. Файл .env не должен попадать в репозиторий.

# --- Telegram-бот менеджера (обязательно для приёма заявок) ---
# Токен бота от @BotFather. Хранится только на сервере.
TELEGRAM_BOT_TOKEN=
# ID чата/группы/пользователя, куда бот пишет заявки (см. README, раздел «Telegram»).
TELEGRAM_CHAT_ID=
# Несколько получателей: TELEGRAM_CHAT_ID=111111,222222

# --- Сервер ---
PORT=3000
# Куда складывать базу заказов (SQLite). На хостинге это должен быть постоянный диск.
DATABASE_PATH=./storage/orders.db
# Часовой пояс для даты в уведомлении и номере заказа.
ORDER_TIMEZONE=Europe/Moscow
# 1 — если сайт за прокси/CDN (nginx, Cloudflare, Render…): IP клиента берётся из X-Forwarded-For.
TRUST_PROXY=0

# --- Публичные ссылки (необязательно) ---
# Ссылка на Telegram магазина для кнопок «Telegram» (например https://t.me/username).
# Если пусто — кнопки Telegram скрываются.
PUBLIC_TELEGRAM_URL=
# Публичный адрес сайта (для canonical/og:url), например https://ihva-parfum.ru
SITE_URL=

# --- Только для разработки/тестов ---
# Адрес Telegram Bot API. По умолчанию https://api.telegram.org
# TELEGRAM_API_BASE=http://127.0.0.1:8081
